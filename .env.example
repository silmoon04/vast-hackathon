# Copy to a file OUTSIDE the repo (or .env, which is gitignored) and point VAST_ENV_FILE at it.
# On the lab VM nothing is needed: vastkit reads the single /config/*.config automatically.
# Windows: never rely on USERNAME (it is your Windows account); use VSS_USERNAME.
# Keep comments on their own line: some .env loaders read text after `KEY=` as the value.

# --- VSS backend (private: reach it from the VM, or from the laptop through the SOCKS tunnel) ---
# = INGRESS_URL from /config/<team>.config
VSS_BASE_URL=
# team id, e.g. team-7
VSS_USERNAME=
VSS_PASSWORD=
# socks5h://127.0.0.1:1080 when tunnelling from the laptop (scripts/tunnel.ps1); loopback URLs bypass it
VAST_SOCKS=

# --- GPU endpoints (each its own host:port; copy the URLs, never derive one from another) ---
COSMOS3_REASON_URL=
# optional; discovered from /v1/models
COSMOS3_REASON_MODEL=
COSMOS_EMBED1_URL=
YOLO_URL=
CANARY_1B_URL=
# optional; only if the organisers say the endpoints need one
GPU_BEARER_TOKEN=

# --- Storage (VM only: data VIP and Query Engine are private) ---
S3_ENDPOINT=
ACCESS_KEY=
SECRET_KEY=
VDB_ENDPOINT=
# <team>-vss-db
VASTDB_BUCKET=

# --- W&B Inference + Weave (set the key in your shell, not in a file you might commit) ---
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=
# shell environment only: read by weave from os.environ, never from this file
# WEAVE_PARALLELISM=4

# --- Other OpenAI-compatible LLM servers (vastkit.llm) ---
# shell environment only: read from os.environ, never from this file.
# Unset = W&B Inference; WANDB_API_KEY is only ever sent to W&B Inference.
# LLM_BASE_URL=
# key for LLM_BASE_URL (a loopback server works without one)
# LLM_API_KEY=

# --- Offline development ---
# 1 = VSS mock :8765 + GPU mock :8766 (python -m vastkit mock); replaces the VSS URL,
# credentials and every GPU URL with the mock's, and ignores VAST_SOCKS
VSS_MOCK=0
# optional; only when the mocks run on other ports (python -m vastkit mock --vss-port/--gpu-port)
MOCK_VSS_URL=
MOCK_GPU_URL=
# shell environment only: read by the VSS mock from os.environ, never from this file.
# Optional JSON corpus from scripts/build_mock_corpus.py (default: tiny synthetic one)
# VSS_MOCK_CORPUS=

# --- Local GPU mirrors (python -m vastkit local; read from the shell or this file) ---
# Leave a key commented out or empty to keep the server's default (vastkit local ignores empty values;
# other .env loaders may not).
# Hugging Face cache holding Cosmos3-Edge and Cosmos-Embed1
# HF_HOME=
# path to yolo11s.pt / yolo26s.engine (default: yolo11s.pt, fetched by ultralytics)
# LOCAL_YOLO_WEIGHTS=
# default nvidia/Cosmos3-Edge
# LOCAL_COSMOS_MODEL=
# extra model ids /v1/models should list (e.g. the hosted id), comma separated
# LOCAL_COSMOS_ALIASES=
# optional: require this bearer on the local mirrors
# LOCAL_BEARER=
