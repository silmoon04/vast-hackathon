# secrets: never commit team config, keys or tokens
.env
.env.*
*.env
!.env.example
*.config
*-k8s.yaml
*secret*.yaml
!deploy/**/*.example.yaml
*.pem
*.key
vast_bc*

# local chat monitoring and superseded disclosure documents
/.video-atlas-watch.json
/PRE-EXISTING.md
/templates/PRE-EXISTING.template.md

# data and model artefacts (large, regenerable). No *.ts here: that would also hide TypeScript
# sources; keep MPEG-TS segments under data/ or runs/.
data/
runs/
outbox/
out/
_work/
_scratch/
_cache/
cache/
logs/
